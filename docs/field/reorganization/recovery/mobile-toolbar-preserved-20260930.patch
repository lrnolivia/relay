+const NARROW_TOOLBAR_QUERY = '(max-width: 600px)';
+
+function useNarrowToolbarLayout(): boolean {
+  const [narrow, setNarrow] = useState(() =>
+    typeof window !== 'undefined' && window.matchMedia(NARROW_TOOLBAR_QUERY).matches,
+  );
+
+  useEffect(() => {
+    const media = window.matchMedia(NARROW_TOOLBAR_QUERY);
+    const sync = () => setNarrow(media.matches);
+    sync();
+    media.addEventListener('change', sync);
+    return () => media.removeEventListener('change', sync);
+  }, []);
+
+  return narrow;
+}
+
+function ActiveMobileToolGlyph({
+  toolMode,
+  commentModeActive,
+}: {
+  toolMode: ToolMode;
+  commentModeActive: boolean;
+}) {
+  if (commentModeActive) return <CommentBubbleIcon className="h-[18px] w-[18px]" />;
+  if (toolMode === 'hand') return <HandToolbarIcon className="h-[18px] w-[18px]" />;
+  if (toolMode === 'scale') return <ScaleToolbarIcon className="h-[18px] w-[18px]" />;
+  if (toolMode === 'frame') return <FrameToolbarIcon className="h-[18px] w-[18px]" />;
+  if (toolMode === 'text') return <TextToolbarIcon className="h-[18px] w-[18px]" />;
+  if (toolMode === 'shape-ellipse') return <ShapeCircleIcon className="h-[18px] w-[18px]" />;
+  if (toolMode === 'shape-triangle') return <ShapeTriangleIcon className="h-[18px] w-[18px]" />;
+  if (toolMode === 'shape-line') return <LineToolbarIcon className="h-[18px] w-[18px]" />;
+  if (toolMode === 'shape-path') return <ShapePathIcon className="h-[18px] w-[18px]" />;
+  if (toolMode === 'sketch') return <SketchPencilIcon className="h-[18px] w-[18px]" size={18} />;
+  if (toolMode === 'shape-rect') return <ShapeSquareIcon className="h-[18px] w-[18px]" />;
+  return <CursorIcon className="h-[18px] w-[18px] translate-y-px" />;
+}
+
