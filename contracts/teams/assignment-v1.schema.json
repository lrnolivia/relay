{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Relay assignment teams v1",
  "description": "Durable routing metadata only. Owner, path and project authority are unchanged.",
  "type": "object",
  "properties": {
    "primary_team": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "inspector",
        "runner",
        "night-shift",
        "source",
        "cloud",
        "release",
        "skills",
        null
      ]
    },
    "supporting_teams": {
      "type": "array",
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "inspector",
          "runner",
          "night-shift",
          "source",
          "cloud",
          "release",
          "skills"
        ]
      }
    }
  }
}
