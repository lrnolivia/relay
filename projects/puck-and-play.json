{
  "id": "puck-and-play",
  "name": "Puck & Play",
  "repository": "lrnolivia/puck-and-play",
  "managed": true,
  "default_branch": "main",
  "implementation": {
    "branch_prefixes": ["codex/", "puck-and-play/"],
    "excluded_branches": ["main"],
    "draft_pr_required": true,
    "merge_method": "squash"
  },
  "runtime": {
    "kind": "dotnet",
    "platform": "windows-x64",
    "bootstrap_source": "AGENTS.md"
  },
  "validation": {
    "source": "README.md#build-from-source",
    "repo_defined": true,
    "build": "powershell -NoProfile -File ./Build.ps1",
    "test": "./bin/Guard.Diagnostics.exe --test",
    "package": "powershell -NoProfile -File ./Build-Release.ps1 -SkipBuild"
  },
  "qa": {
    "authority": "lrnolivia/relay@main/LOEW_CHAT_BIBLE.md#11-qa-law",
    "runner_first": true,
    "runtime_required_for_web_visible_changes": false,
    "native_runtime_required_for_visible_changes": true
  },
  "safety": {
    "force_push": false,
    "bypass_required_checks": false,
    "semantic_conflict_resolution": "block",
    "dependency_intent_changes": "block"
  },
  "guidance": {
    "universal_authority": "lrnolivia/relay@main/LOEW_CHAT_BIBLE.md",
    "local_bootstrap": "AGENTS.md",
    "historical_repository_targets_are_non_authoritative": true
  },
  "coordination": {
    "contract": "docs/WORK_COORDINATION.md",
    "record": "coordination/puck-and-play.json",
    "max_active_branches": 4,
    "lease_hours": 12,
    "one_active_branch_per_owner": true,
    "resume_existing_assignment": true,
    "atomic_claim_required": true,
    "expired_claim_retains_ownership": true,
    "audit_workflow": "coordination.yml",
    "cleanup": "merged-managed-branches-only",
    "status": "enabled",
    "admission_workflow": "lrnolivia/relay:.github/workflows/coordination.yml"
  }
}
