{
  "id": "loew-runner",
  "name": "relay compatibility alias",
  "repository": "lrnolivia/relay",
  "managed": false,
  "default_branch": "main",
  "implementation": {
    "branch_prefixes": [
      "loew-runner/"
    ],
    "excluded_branches": [
      "main"
    ],
    "draft_pr_required": true,
    "merge_method": "squash"
  },
  "runtime": {
    "kind": "node",
    "node_version": "22",
    "package_manager": "npm"
  },
  "validation": {
    "check": "npm run check",
    "test": "npm test",
    "required": [
      "check",
      "test"
    ]
  },
  "qa": {
    "authority": "lrnolivia/relay@main/LOEW_CHAT_BIBLE.md#11-qa-law",
    "runner_first": true,
    "runtime_required_for_web_visible_changes": true,
    "routine_engine": "deterministic-inspector-github-chromium",
    "browser_run": "exploratory-or-session-only"
  },
  "promotion": {
    "automatic": true,
    "repair_artificial_blockers": true,
    "exact_sha_gate": true,
    "max_transient_retries": 2,
    "auto_update_branch": true,
    "auto_create_pr": true,
    "auto_merge": true
  },
  "safety": {
    "force_push": false,
    "bypass_required_checks": false,
    "semantic_conflict_resolution": "block",
    "dependency_intent_changes": "block"
  },
  "guidance": {
    "universal_authority": "lrnolivia/relay@main/LOEW_CHAT_BIBLE.md",
    "local_bootstrap": "AGENTS.md",
    "historical_repository_targets_are_non_authoritative": true
  },
  "coordination": {
    "contract": "docs/WORK_COORDINATION.md",
    "record": "coordination/loew-runner.json",
    "max_active_branches": 4,
    "lease_hours": 12,
    "one_active_branch_per_owner": true,
    "resume_existing_assignment": true,
    "atomic_claim_required": true,
    "expired_claim_retains_ownership": true,
    "audit_workflow": "coordination.yml",
    "cleanup": "merged-managed-branches-only",
    "status": "enabled",
    "admission_workflow": "lrnolivia/loew-runner:.github/workflows/runner-coordination.yml",
    "cleanup_workflow": "lrnolivia/loew-runner:.github/workflows/runner-coordination.yml"
  },
  "alias_of": "relay",
  "retirement": {
    "status": "recovery-only",
    "canonical_project": "relay",
    "record_is_historical": true
  }
}
