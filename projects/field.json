{
  "id": "field",
  "name": "field",
  "repository": "lrnolivia/field",
  "managed": true,
  "default_branch": "main",
  "implementation": {
    "branch_prefixes": [
      "field/"
    ],
    "excluded_branches": [
      "main",
      "field/control",
      "relay-write-proof"
    ],
    "draft_pr_required": true,
    "merge_method": "squash"
  },
  "runtime": {
    "kind": "node",
    "node_version": "22",
    "package_manager": "npm",
    "lockfile": "package-lock.json",
    "install": "npm ci"
  },
  "validation": {
    "build": "npm run build:all",
    "test": "npm run test:run",
    "lint": "npm run lint",
    "required": [
      "install",
      "build",
      "test",
      "lint"
    ]
  },
  "qa": {
    "authority": "lrnolivia/relay@main/LOEW_CHAT_BIBLE.md#11-qa-law",
    "runner_first": true,
    "runtime_required_for_web_visible_changes": true,
    "routine_engine": "deterministic-inspector-github-chromium",
    "browser_run": "exploratory-or-session-only",
    "real_project_entrypoint": "/qa/work/<projectId>",
    "smoke_only_entrypoint": "/builder/noauth",
    "project_overlay": "docs/field/qa/BROWSER_PREVIEW_QA_PROTOCOL.md",
    "preview_endpoints": [
      "https://field.loew.fi",
      "https://canvas.field.loew.fi",
      "https://preview.field.loew.fi"
    ]
  },
  "promotion": {
    "automatic": true,
    "repair_artificial_blockers": true,
    "exact_sha_gate": true,
    "max_transient_retries": 2,
    "auto_update_branch": true,
    "auto_create_pr": true,
    "auto_merge": true
  },
  "safety": {
    "force_push": false,
    "bypass_required_checks": false,
    "semantic_conflict_resolution": "block",
    "dependency_intent_changes": "block"
  },
  "guidance": {
    "universal_authority": "lrnolivia/relay@main/LOEW_CHAT_BIBLE.md",
    "local_bootstrap": "AGENTS.md",
    "historical_repository_targets_are_non_authoritative": true
  },
  "reorganization": {
    "status": "ready",
    "active_assignment": "assignments/field-repo-cleanup-reorg.json",
    "plan": "docs/FIELD_REPOSITORY_REORGANIZATION.md",
    "preserve_active_workstreams": [
      "mobile-focus",
      "runner-inspector-infrastructure"
    ],
    "historical_worker_reports_are_provenance_not_future_ownership": true,
    "target_domains": {
      "canvas": {
        "name": "Canvas & Interaction",
        "future_branch_prefix": "canvas/"
      },
      "workspace": {
        "name": "Workspace Shell",
        "future_branch_prefix": "workspace/"
      },
      "controls": {
        "name": "Inspector & Design Controls",
        "future_branch_prefix": "controls/"
      },
      "assets": {
        "name": "Assets & Media",
        "future_branch_prefix": "assets/"
      },
      "mobile": {
        "name": "Mobile Focus",
        "future_branch_prefix": "mobile/",
        "preserve_existing_owner": true
      }
    },
    "target_branch_policy": {
      "durable_workers_short_lived_branches": true,
      "no_chat_continuation_branches": true,
      "delete_merged_task_branches": true,
      "future_prefixes": [
        "canvas/",
        "workspace/",
        "controls/",
        "assets/",
        "mobile/"
      ],
      "future_roadmap_prefixes": [
        "figma/",
        "model/"
      ],
      "keep_current_field_prefix_until_workflow_compatibility_verified": true
    }
  },
  "coordination": {
    "contract": "docs/WORK_COORDINATION.md",
    "record": "coordination/field.json",
    "max_active_branches": 4,
    "lease_hours": 12,
    "one_active_branch_per_owner": true,
    "resume_existing_assignment": true,
    "atomic_claim_required": true,
    "expired_claim_retains_ownership": true,
    "legacy_inventory": "docs/field/reorganization/2026-09-30-inventory.json",
    "audit_workflow": "coordination.yml",
    "cleanup": "merged-managed-branches-only",
    "status": "enabled",
    "admission_workflow": "lrnolivia/field:.github/workflows/runner-coordination.yml",
    "cleanup_workflow": "lrnolivia/field:.github/workflows/runner-coordination.yml"
  },
  "cloud": {
    "provider": "cloudflare",
    "worker": "field",
    "write": true,
    "transport": "workers-builds",
    "production_branch": "main",
    "build_command": "npm run build:all",
    "deploy_command": "npx wrangler deploy",
    "manual_upload": "recovery-only"
  }
}
